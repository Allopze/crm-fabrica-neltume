# Copia este archivo a .env.compras.local (desarrollo) y completa los valores. Nunca lo subas a git con valores.
# Credenciales de la API de Chipax: en Chipax, Ajustes → Credenciales API (https://app.chipax.com/secret_keys). ADR-0021.
CHIPAX_APP_ID=
CHIPAX_SECRET_KEY=
# Opcional: otra URL de la API (por omisión https://api.chipax.com/v2).
CHIPAX_API_URL=
