# Copia este archivo a .env.local (dev) o .env (producción) y completa los valores.
# Nunca subas a git un archivo con valores reales.

# --- Base de datos ---
# Superusuario local para crear roles y bases (solo `npm run db:setup`). Postgres.app: postgres://<tu-usuario>@localhost:5432/postgres
DATABASE_ADMIN_URL=
# Dueño del esquema: aplica migraciones. Formato postgres://neltume_owner:<clave>@localhost:5432/neltume
DATABASE_URL_OWNER=
# Rol de la app: sin UPDATE/DELETE sobre audit_log ni movimiento. Formato postgres://neltume_app:<clave>@localhost:5432/neltume
DATABASE_URL=
# Rol del worker de IA, con permisos mínimos (ADR-0017). Obligatorio en Compose: postgres://neltume_worker:<clave>@db:5432/neltume
# En desarrollo puede quedar vacío: se deriva de DATABASE_URL (`npm run db:setup` crea el rol).
DATABASE_URL_WORKER=
# Rol del servicio de compras desde Chipax (ADR-0021): solo recepciones de materias primas. Compose: postgres://neltume_compras:<clave>@db:5432/neltume
# En desarrollo puede quedar vacío: se deriva de DATABASE_URL.
DATABASE_URL_COMPRAS=
# Rol del servicio de enlace con la tienda (ADR-0024): solo el resultado de las pruebas de conexión. Compose: postgres://neltume_enlace:<clave>@db:5432/neltume
# En desarrollo puede quedar vacío: se deriva de DATABASE_URL.
DATABASE_URL_ENLACE=
# Solo producción (Compose): superusuario del contenedor db.
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- App ---
# URL pública (producción: el hostname del túnel; dev: http://localhost:3000)
APP_URL=

# --- IA (solo producción/Compose; Compose entrega las claves solo al worker) ---
# En desarrollo, deja estas variables vacías aquí y usa .env.worker.local.
CMD_API_KEY=
CMD_API_BASE_URL=
# Parámetros compartidos por proveedor.
LLM_TIMEOUT_MS=
LLM_MAX_TOKENS_SALIDA=
LLM_MAX_REINTENTOS=
LLM_TOPE_DIARIO_USD=
# Tope diario de llamadas al LLM (por defecto 300); limita el gasto también si el proveedor no informa costo.
LLM_TOPE_DIARIO_LLAMADAS=
# Segundos tras los que un trabajo de IA en curso se da por colgado (por defecto 180).
IA_TRABAJO_COLGADO_S=
# Presupuesto mensual en USD: solo alerta (al 80 %) en el panel, en /administracion/metricas y en los logs del worker
LLM_PRESUPUESTO_MENSUAL_USD=

# --- Recepción automática de las notas de la tienda (ADR-0023) ---
# Secreto HMAC compartido SOLO con el cotizador de la tienda (allí: NELTUME_FABRICA_PANGUIPULLI_SECRETO). Al menos 32
# caracteres: `openssl rand -base64 32`. Vacío = la integración está apagada y responde 503. Solo lo recibe la app.
INTEGRACION_TIENDA_SECRETO=
# Durante una rotación, el secreto anterior (RUNBOOK §8); vacío el resto del tiempo.
INTEGRACION_TIENDA_SECRETO_ANTERIOR=
# Código de esta fábrica en el contrato (por omisión PANGUIPULLI).
INTEGRACION_TIENDA_FABRICA=
# RUT del cliente de tipo «tienda» al que se cargan las notas recibidas (Clientes → tienda).
INTEGRACION_TIENDA_CLIENTE_RUT=

# --- Prueba de conexión con la tienda (ADR-0024) ---
# El botón de Ajustes → «Conexión con la tienda» firma con INTEGRACION_TIENDA_SECRETO (la app) y el servicio `enlace` envía.
# Origen de la tienda, sin ruta: https://cotizador.puertasneltume.cl. Solo lo recibe el servicio `enlace` (perfil `tienda`);
# en desarrollo va en .env.enlace.local. Vacío = las pruebas quedan «sin configurar».
ENLACE_TIENDA_URL=
# Plazo de cada envío en milisegundos (1000–60000; por omisión 15000).
ENLACE_TIENDA_TIMEOUT_MS=

# --- Producción ---
# Perfiles opcionales de Compose; `ia` levanta el worker del cotizador, `chipax` el servicio de compras (ADR-0021) y
# `tienda` el servicio de enlace con la tienda (ADR-0024)
COMPOSE_PROFILES=
# Credenciales de la API de Chipax (Ajustes → Credenciales API). Solo producción; en desarrollo van en .env.compras.local.
CHIPAX_APP_ID=
CHIPAX_SECRET_KEY=
# Token del túnel de Cloudflare
TUNNEL_TOKEN=
# Días que se conservan los respaldos locales
BACKUP_RETENCION_DIAS=
# Ruta del HOST para la copia externa (otro disco, NAS o carpeta sincronizada fuera del servidor). Obligatoria en producción.
BACKUP_DESTINO_EXTERNO=

# --- Datos de la empresa impresos en los PDF (opcionales; vacíos no se imprimen) ---
NELTUME_EMPRESA_NOMBRE=
NELTUME_EMPRESA_RUT=
NELTUME_EMPRESA_DIRECCION=
NELTUME_EMPRESA_TELEFONO=
NELTUME_EMPRESA_WEB=
NELTUME_EMPRESA_CORREO=
